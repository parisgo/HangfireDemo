{
  "ConnectionStrings": {
    "HangfireConnection": "",
    "ApplicationConnection": ""
  },
  "Hangfire": {
    "Queues": ["default", "imports"],
    "WorkerCount": 0,
    "DailyImportCron": "0 2 * * *",
    "DailyImportTimeZone": "Europe/Paris",
    "ServerHeartbeatTimeoutSeconds": 120,
    "PrepareSchemaIfNecessary": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "localhost"
}
