{
  "ConnectionStrings": {
    "HangfireConnection": ""
  },
  "Hangfire": {
    "ServerHeartbeatTimeoutSeconds": 120,
    "PrepareSchemaIfNecessary": false
  },
  "Security": {
    "HeaderName": "X-Hangfire-Api-Key",
    "AdminApiKey": "",
    "ReaderApiKey": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    },
    "File": {
      "Directory": "Logs",
      "FileSizeLimitBytes": 52428800,
      "RetainedFileCountLimit": 31
    },
    "Seq": {
      "Enabled": true,
      "ServerUrl": "http://localhost:5341",
      "ApiKey": ""
    }
  },
  "AllowedHosts": "localhost"
}
